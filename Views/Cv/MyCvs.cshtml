@model List<TalentManagement.Models.Entities.CV>
@{
    ViewData["Title"] = "My Applications & CVs";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h1 class="h3 fw-bold mb-0">My Applications &amp; CVs</h1>
        <p class="text-muted small mb-0">Track and manage your job applications and qualifications</p>
    </div>
    <div>
        <a asp-controller="Position" asp-action="Index" class="btn btn-dark btn-sm">+ Apply to Open Positions</a>
    </div>
</div>

<div class="card p-0">
    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Target Position</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Last Modified</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cv in Model)
                    {
                        <tr>
                            <td class="fw-semibold">
                                <a asp-action="Details" asp-route-id="@cv.Id" class="text-dark text-decoration-none">
                                    @cv.Position?.Title
                                </a>
                            </td>
                            <td>
                                <span class="badge @(cv.Status == TalentManagement.Models.Enums.CvStatus.Published ? "bg-dark" : "bg-secondary")">
                                    @cv.Status
                                </span>
                            </td>
                            <td class="small text-muted">@cv.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td class="small text-muted">@(cv.UpdatedAt?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@cv.Id" class="btn btn-sm btn-outline-dark me-1">
                                    View
                                </a>
                                <a asp-action="Edit" asp-route-id="@cv.Id" class="btn btn-sm btn-dark me-1">
                                    Edit
                                </a>
                                <form asp-action="Delete" asp-route-id="@cv.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this CV?');">
                                    <input type="hidden" name="rowVersion" value="@(cv.RowVersion != null ? Convert.ToBase64String(cv.RowVersion) : "")" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="p-5 text-center text-muted">
            <h2 class="h5 fw-semibold mb-2">No Applications Created Yet</h2>
            <p class="mb-3">Browse available openings and submit your tailored CV application.</p>
            <a asp-controller="Position" asp-action="Index" class="btn btn-dark">Browse Available Positions</a>
        </div>
    }
</div>
