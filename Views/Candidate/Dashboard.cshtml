@model TalentManagement.ViewModels.CandidateDashboardViewModel
@{
    ViewData["Title"] = "Candidate Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div class="d-flex align-items-center gap-3">
        @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
        {
            <img src="@Model.ProfileImageUrl" alt="Profile" class="avatar-sm" />
        }
        <div>
            <h1 class="h3 fw-bold mb-0">Welcome, @Model.CandidateName</h1>
            <p class="text-muted small mb-0">@Model.Email, Candidate Portal</p>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Position" asp-action="Index" class="btn btn-dark btn-sm">Browse Positions</a>
        <a asp-controller="Project" asp-action="Create" class="btn btn-outline-dark btn-sm">Add Project</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="stat-box">
            <div class="stat-value">@Model.TotalApplicationsCount</div>
            <div class="stat-label">Total Applications</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="stat-box">
            <div class="stat-value">@Model.PublishedApplicationsCount</div>
            <div class="stat-label">Published Applications</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="stat-box">
            <div class="stat-value">@Model.DraftApplicationsCount</div>
            <div class="stat-label">Draft Applications</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="stat-box">
            <div class="stat-value">@Model.TotalProjectsCount</div>
            <div class="stat-label">Portfolio Projects</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-bold">My Applications &amp; CVs</span>
                <a asp-controller="Cv" asp-action="MyCvs" class="small">View All</a>
            </div>
            <div class="card-body p-0">
                @if (Model.MyCvs != null && Model.MyCvs.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Position</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cv in Model.MyCvs)
                                {
                                    <tr>
                                        <td class="fw-semibold">@cv.Position?.Title</td>
                                        <td>
                                            <span class="badge @(cv.Status == TalentManagement.Models.Enums.CvStatus.Published ? "bg-dark" : "bg-secondary")">
                                                @cv.Status
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <a asp-controller="Cv" asp-action="Details" asp-route-id="@cv.Id" class="btn btn-sm btn-outline-dark me-1">
                                                View
                                            </a>
                                            <a asp-controller="Cv" asp-action="Edit" asp-route-id="@cv.Id" class="btn btn-sm btn-dark">
                                                Edit
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted">
                        You have not created any CVs yet.
                        <div class="mt-2">
                            <a asp-controller="Position" asp-action="Index" class="btn btn-dark btn-sm">Find Jobs to Apply</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-bold">Available Positions</span>
                <a asp-controller="Position" asp-action="Index" class="small">Browse All</a>
            </div>
            <div class="card-body p-0">
                @if (Model.AvailablePositions != null && Model.AvailablePositions.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var pos in Model.AvailablePositions)
                        {
                            <li class="list-group-item p-3 d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold">@pos.Title</div>
                                    <div class="small text-muted">Posted @pos.CreatedAt.ToString("yyyy-MM-dd")</div>
                                </div>
                                <div class="d-flex gap-2">
                                    <a asp-controller="Position" asp-action="Details" asp-route-id="@pos.Id" class="btn btn-sm btn-outline-dark">
                                        Details
                                    </a>
                                    <a asp-controller="Cv" asp-action="Create" asp-route-positionId="@pos.Id" class="btn btn-sm btn-dark">
                                        Apply
                                    </a>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="p-4 text-center text-muted">No positions available at the moment.</div>
                }
            </div>
        </div>
    </div>
</div>
