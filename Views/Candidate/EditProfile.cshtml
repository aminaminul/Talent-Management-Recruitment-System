@model TalentManagement.ViewModels.CandidateProfileViewModel
@{
    ViewData["Title"] = "Edit Profile";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <partial name="_ConcurrencyAlert" />

        <div class="card p-4">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                <h1 class="h4 fw-bold mb-0">Edit Profile</h1>
                <a asp-action="Profile" class="btn btn-outline-dark btn-sm">Cancel</a>
            </div>

            <form asp-action="EditProfile" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="RowVersion" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-semibold"></div>

                <div class="row mb-4 align-items-center">
                    <div class="col-auto">
                        @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
                        {
                            <img src="@Model.ProfileImageUrl" alt="Current Photo" class="avatar-img" />
                        }
                        else
                        {
                            <div class="avatar-img bg-light d-flex align-items-center justify-content-center fw-bold fs-4">
                                @(string.IsNullOrEmpty(Model.FullName) ? "U" : Model.FullName.Substring(0, 1).ToUpper())
                            </div>
                        }
                    </div>
                    <div class="col">
                        <label asp-for="ProfileImageFile" class="form-label"></label>
                        <input asp-for="ProfileImageFile" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp" />
                        <span asp-validation-for="ProfileImageFile" class="text-danger small"></span>
                        <div class="form-text text-muted">Upload JPG, PNG, or WebP. Max file size: 2MB.</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" readonly />
                        <div class="form-text text-muted">Email is tied to your login account.</div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="+1 555-0199" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Bio" class="form-label"></label>
                    <textarea asp-for="Bio" class="form-control" rows="4" placeholder="Brief summary of your professional expertise and career goals..."></textarea>
                    <span asp-validation-for="Bio" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-dark">Save Profile</button>
                    <a asp-action="Profile" class="btn btn-outline-dark">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
