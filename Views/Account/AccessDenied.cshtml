@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center text-center py-5">
    <div class="col-md-6">
        <div class="card p-5">
            <h1 class="display-5 fw-bold mb-3">403</h1>
            <h2 class="h4 fw-semibold mb-3">Access Denied</h2>
            <p class="text-muted mb-4">
                You do not have the required permissions to access this page. Please log in with an authorized account or return to the home page.
            </p>
            <div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-dark">Return to Home</a>
            </div>
        </div>
    </div>
</div>
