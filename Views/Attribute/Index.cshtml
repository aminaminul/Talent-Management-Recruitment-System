@model TalentManagement.ViewModels.AttributeListViewModel
@{
    ViewData["Title"] = "Dynamic Attributes";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h1 class="h3 fw-bold mb-0">Dynamic Attributes</h1>
        <p class="text-muted small mb-0">Define arbitrary, independent technical and professional qualifications</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-dark btn-sm">+ Create Attribute</a>
    </div>
</div>

<div class="card p-3 mb-4 bg-light">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-5">
            <input type="text" name="search" value="@Model.SearchTerm" class="form-control form-control-sm" placeholder="Search attributes by name..." />
        </div>
        <div class="col-md-4">
            <select name="categoryId" class="form-select form-select-sm">
                <option value="">-- All Categories --</option>
                @foreach (var cat in Model.CategoryOptions)
                {
                    <option value="@cat.Value" selected="@(Model.SelectedCategoryId?.ToString() == cat.Value)">
                        @cat.Text
                    </option>
                }
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-dark btn-sm flex-grow-1">Filter</button>
            <a asp-action="Index" class="btn btn-outline-dark btn-sm">Reset</a>
        </div>
    </form>
</div>

<div class="card p-0">
    @if (Model.Attributes != null && Model.Attributes.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Attribute Name</th>
                        <th>Type</th>
                        <th>Category</th>
                        <th>Dropdown Options</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var attr in Model.Attributes)
                    {
                        <tr>
                            <td class="fw-semibold">
                                <a asp-action="Details" asp-route-id="@attr.Id" class="text-decoration-none text-dark">
                                    @attr.Name
                                </a>
                            </td>
                            <td>
                                <span class="badge bg-secondary">@attr.AttributeType</span>
                            </td>
                            <td>@(attr.Category?.Name ?? "General")</td>
                            <td>
                                @if (attr.AttributeType == TalentManagement.Models.Enums.AttributeType.Dropdown)
                                {
                                    <span class="small text-muted">@attr.Options.Count option(s)</span>
                                }
                                else
                                {
                                    <span class="small text-muted">&mdash;</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@attr.Id" class="btn btn-sm btn-outline-dark me-1">
                                    Details
                                </a>
                                <a asp-action="Edit" asp-route-id="@attr.Id" class="btn btn-sm btn-dark me-1">
                                    Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@attr.Id" class="btn btn-sm btn-outline-danger">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="p-4 text-center text-muted">
            No attributes found matching your criteria.
            <div class="mt-2">
                <a asp-action="Create" class="btn btn-dark btn-sm">Create New Attribute</a>
            </div>
        </div>
    }
</div>

<partial name="_Pagination" model="Model.Attributes" />
