@model TalentManagement.ViewModels.AttributeEditViewModel
@{
    ViewData["Title"] = "Edit Dynamic Attribute";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <partial name="_ConcurrencyAlert" />

        <div class="card p-4">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                <div>
                    <h1 class="h4 fw-bold mb-0">Edit Attribute</h1>
                    <span class="badge bg-secondary">Type: @Model.AttributeType</span>
                </div>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-dark btn-sm">Cancel</a>
            </div>

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="AttributeType" />
                <input type="hidden" asp-for="RowVersion" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-semibold"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" autofocus />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                    <div class="form-text text-muted">
                        Note: Renaming an attribute updates its label everywhere without breaking historical candidate CV values.
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label"></label>
                    <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="form-select">
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>

                @if (Model.AttributeType == TalentManagement.Models.Enums.AttributeType.Dropdown)
                {
                    <div class="mb-4">
                        <label asp-for="OptionsRaw" class="form-label"></label>
                        <textarea asp-for="OptionsRaw" class="form-control" rows="6"></textarea>
                        <span asp-validation-for="OptionsRaw" class="text-danger small"></span>
                        <div class="form-text text-muted">One option per line. Updates will be reflected in dropdown choices.</div>
                    </div>
                }

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-dark">Save Changes</button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-dark">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
