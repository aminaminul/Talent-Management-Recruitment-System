@model TalentManagement.ViewModels.AttributeDetailsViewModel
@{
    ViewData["Title"] = "Delete Qualification - " + Model.Name;
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card p-4">
            <h1 class="h4 fw-bold mb-3">Delete Skill / Qualification</h1>
            <p class="text-muted">
                Are you sure you want to delete the qualification <strong>@Model.Name</strong>?
            </p>

            <div class="alert alert-secondary mb-4">
                <div><strong>Answer Format:</strong> @Model.AttributeType</div>
                <div><strong>Category:</strong> @Model.CategoryName</div>
                <div><strong>Positions Using It:</strong> @Model.PositionUsageCount</div>
                <div><strong>Candidate Applications Using It:</strong> @Model.CvUsageCount</div>
            </div>

            @if (Model.CanDelete)
            {
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="RowVersion" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-dark">Confirm Delete</button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-dark">Cancel</a>
                    </div>
                </form>
            }
            else
            {
                <div class="alert alert-danger mb-4">
                    <strong>Cannot Delete:</strong> This qualification is currently referenced by active job positions or candidate CV applications. To preserve data integrity, it cannot be deleted while in use.
                </div>
                <div>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-dark">Back to Details</a>
                </div>
            }
        </div>
    </div>
</div>
