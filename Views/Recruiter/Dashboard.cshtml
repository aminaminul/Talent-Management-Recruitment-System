@model TalentManagement.ViewModels.RecruiterDashboardViewModel
@{
    ViewData["Title"] = "Recruiter Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h1 class="h3 fw-bold mb-0">Recruiter Dashboard</h1>
        <p class="text-muted small mb-0">Talent pipeline management and attribute configurations</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Position" asp-action="Create" class="btn btn-dark btn-sm">+ New Position</a>
        <a asp-controller="Attribute" asp-action="Create" class="btn btn-outline-dark btn-sm">+ New Attribute</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="stat-box">
            <div class="stat-value">@Model.TotalPositions</div>
            <div class="stat-label">Total Positions (@Model.ActivePositions Active)</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="stat-box">
            <div class="stat-value">@Model.TotalCandidates</div>
            <div class="stat-label">Registered Candidates</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="stat-box">
            <div class="stat-value">@Model.TotalPublishedCvs</div>
            <div class="stat-label">Published Applications</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="stat-box">
            <div class="stat-value">@Model.TotalAttributes</div>
            <div class="stat-label">Dynamic Attributes</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-bold">Active Positions</span>
                <a asp-controller="Position" asp-action="Index" class="small">View All &rarr;</a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentPositions != null && Model.RecentPositions.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>Status</th>
                                    <th>Applications</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pos in Model.RecentPositions)
                                {
                                    <tr>
                                        <td class="fw-semibold">@pos.Title</td>
                                        <td>
                                            <span class="badge @(pos.Status == TalentManagement.Models.Enums.PositionStatus.Active ? "bg-dark" : "bg-secondary")">
                                                @pos.Status
                                            </span>
                                        </td>
                                        <td>@pos.CVs.Count</td>
                                        <td class="text-end">
                                            <a asp-controller="Position" asp-action="Candidates" asp-route-id="@pos.Id" class="btn btn-sm btn-outline-dark me-1">
                                                Review CVs
                                            </a>
                                            <a asp-controller="Position" asp-action="Details" asp-route-id="@pos.Id" class="btn btn-sm btn-dark">
                                                Manage
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted">No positions created yet.</div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-bold">Recent Candidate Applications</span>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentApplications != null && Model.RecentApplications.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var cv in Model.RecentApplications)
                        {
                            <li class="list-group-item p-3 d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold">@cv.CandidateProfile?.FullName</div>
                                    <div class="small text-muted">@cv.Position?.Title</div>
                                    <span class="badge @(cv.Status == TalentManagement.Models.Enums.CvStatus.Published ? "bg-dark" : "bg-secondary") mt-1">
                                        @cv.Status
                                    </span>
                                </div>
                                <a asp-controller="Cv" asp-action="Details" asp-route-id="@cv.Id" class="btn btn-sm btn-outline-dark">
                                    View CV
                                </a>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="p-4 text-center text-muted">No applications submitted yet.</div>
                }
            </div>
        </div>
    </div>
</div>
