@if (ViewBag.ConcurrencyConflict == true)
{
    <div class="alert alert-danger mb-4" role="alert">
        <h5 class="alert-heading fw-bold">[CONCURRENCY CONFLICT DETECTED]</h5>
        <p class="mb-3">
            Someone else modified this record while it was being edited. Your changes were not saved to prevent overwriting their updates.
        </p>
        <hr class="my-2" style="border-color: #000;" />
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-dark btn-sm" onclick="window.location.reload();">
                Reload Latest Version
            </button>
            <a href="javascript:history.back();" class="btn btn-outline-dark btn-sm">
                Cancel &amp; Go Back
            </a>
        </div>
    </div>
}
