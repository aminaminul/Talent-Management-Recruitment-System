@model List<TalentManagement.Models.Entities.Position>
@{
    ViewData["Title"] = "Home";
}

<div class="p-5 mb-4 bg-light rounded-3 border">
    <div class="container-fluid py-3">
        <h1 class="display-5 fw-bold mb-3">Talent Management &amp; Recruitment System</h1>
        <p class="col-md-9 fs-5 text-muted mb-4">
            A minimalist, high-performance platform for managing candidate portfolios, job positions, and dynamic technical qualifications without schema bloat.
        </p>
        <div class="d-flex gap-2">
            <a asp-controller="Position" asp-action="Index" class="btn btn-dark btn-lg px-4">Browse Open Positions</a>
            @if (User.Identity?.IsAuthenticated != true)
            {
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-dark btn-lg px-4">Create Account</a>
            }
        </div>
    </div>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-6">
        <div class="stat-box d-flex align-items-center justify-content-between">
            <div>
                <div class="stat-value">@ViewBag.TotalPositions</div>
                <div class="stat-label">Active Job Openings</div>
            </div>
            <a asp-controller="Position" asp-action="Index" class="btn btn-sm btn-outline-dark">View All</a>
        </div>
    </div>
    <div class="col-md-6">
        <div class="stat-box d-flex align-items-center justify-content-between">
            <div>
                <div class="stat-value">@ViewBag.TotalCandidates</div>
                <div class="stat-label">Registered Candidates</div>
            </div>
            @if (User.Identity?.IsAuthenticated != true)
            {
                <a asp-controller="Account" asp-action="Register" class="btn btn-sm btn-outline-dark">Join Talent Pool</a>
            }
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 fw-bold mb-0">Latest Opportunities</h2>
    <a asp-controller="Position" asp-action="Index" class="small fw-semibold">View all positions &rarr;</a>
</div>

@if (Model != null && Model.Any())
{
    <div class="row g-3">
        @foreach (var pos in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 p-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h3 class="h5 fw-bold mb-0 text-truncate" title="@pos.Title">@pos.Title</h3>
                        <span class="badge bg-dark">Active</span>
                    </div>
                    <p class="text-muted small mb-3 flex-grow-1">
                        @(pos.Description.Length > 120 ? pos.Description.Substring(0, 117) + "..." : pos.Description)
                    </p>

                    @if (pos.TagFilters != null && pos.TagFilters.Any())
                    {
                        <div class="mb-3 d-flex flex-wrap gap-1">
                            @foreach (var tf in pos.TagFilters)
                            {
                                <span class="badge bg-secondary">@tf.Tag?.Name</span>
                            }
                        </div>
                    }

                    <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top">
                        <span class="small text-muted">@pos.CreatedAt.ToString("yyyy-MM-dd")</span>
                        <a asp-controller="Position" asp-action="Details" asp-route-id="@pos.Id" class="btn btn-sm btn-outline-dark">
                            Details &rarr;
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card p-4 text-center text-muted">
        No job positions are currently active. Check back soon.
    </div>
}
