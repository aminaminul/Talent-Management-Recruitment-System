@using TalentManagement.Data
@model TalentManagement.ViewModels.PositionListViewModel
@{
    ViewData["Title"] = "Positions";
    var isRecruiter = User.IsInRole(DbInitializer.RecruiterRole);
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h1 class="h3 fw-bold mb-0">Job Positions</h1>
        <p class="text-muted small mb-0">Browse open positions and recruitment requirements</p>
    </div>
    @if (isRecruiter)
    {
        <div>
            <a asp-action="Create" class="btn btn-dark btn-sm">+ Create Position</a>
        </div>
    }
</div>

<div class="card p-3 mb-4 bg-light">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-6">
            <input type="text" name="search" value="@Model.SearchTerm" class="form-control form-control-sm" placeholder="Search by job title or keyword..." />
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select form-select-sm">
                <option value="">-- All Statuses --</option>
                <option value="Active" selected="@(Model.StatusFilter == TalentManagement.Models.Enums.PositionStatus.Active)">Active</option>
                <option value="Closed" selected="@(Model.StatusFilter == TalentManagement.Models.Enums.PositionStatus.Closed)">Closed</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-dark btn-sm flex-grow-1">Filter</button>
            <a asp-action="Index" class="btn btn-outline-dark btn-sm">Reset</a>
        </div>
    </form>
</div>

<div class="card p-0">
    @if (Model.Positions != null && Model.Positions.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Status</th>
                        <th>Project Filters</th>
                        <th>Attributes</th>
                        <th>Posted Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pos in Model.Positions)
                    {
                        <tr>
                            <td class="fw-semibold">
                                <a asp-action="Details" asp-route-id="@pos.Id" class="text-dark text-decoration-none">
                                    @pos.Title
                                </a>
                            </td>
                            <td>
                                <span class="badge @(pos.Status == TalentManagement.Models.Enums.PositionStatus.Active ? "bg-dark" : "bg-secondary")">
                                    @pos.Status
                                </span>
                            </td>
                            <td>
                                @if (pos.TagFilters != null && pos.TagFilters.Any())
                                {
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var tf in pos.TagFilters)
                                        {
                                            <span class="badge bg-secondary">@tf.Tag?.Name</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">&mdash;</span>
                                }
                            </td>
                            <td>
                                <span class="small text-muted">@pos.PositionAttributes.Count attribute(s)</span>
                            </td>
                            <td class="small text-muted">@pos.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@pos.Id" class="btn btn-sm btn-outline-dark me-1">
                                    Details
                                </a>
                                @if (isRecruiter)
                                {
                                    <a asp-action="Candidates" asp-route-id="@pos.Id" class="btn btn-sm btn-outline-dark me-1" title="Review Applications">
                                        CVs (@pos.CVs.Count)
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@pos.Id" class="btn btn-sm btn-dark me-1">
                                        Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@pos.Id" class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>
                                }
                                else if (User.IsInRole(DbInitializer.CandidateRole))
                                {
                                    <a asp-controller="Cv" asp-action="Create" asp-route-positionId="@pos.Id" class="btn btn-sm btn-dark">
                                        Apply
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="p-4 text-center text-muted">
            No positions found matching your filter criteria.
        </div>
    }
</div>

<partial name="_Pagination" model="Model.Positions" />
