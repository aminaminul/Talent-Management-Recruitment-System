@model TalentManagement.ViewModels.PositionDetailsViewModel
@{
    ViewData["Title"] = "Delete Position - " + Model.Title;
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card p-4">
            <h1 class="h4 fw-bold mb-3">[CONFIRM DELETION]</h1>
            <p class="text-muted">
                Are you sure you want to delete the job position <strong>@Model.Title</strong>?
            </p>

            <div class="alert alert-secondary mb-4">
                <div><strong>Status:</strong> @Model.Status</div>
                <div><strong>Qualifications Required:</strong> @Model.Attributes.Count</div>
                <div><strong>Candidate Applications:</strong> @Model.TotalApplicationsCount</div>
                <div class="small text-muted mt-2">
                    Note: Deleting this position removes the opening and its application requirements, but does <strong>NOT</strong> delete any shared qualifications from the system library.
                </div>
            </div>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="RowVersion" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-dark">Confirm Delete</button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-dark">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
