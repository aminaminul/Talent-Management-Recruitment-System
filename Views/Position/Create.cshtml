@model TalentManagement.ViewModels.PositionCreateViewModel
@{
    ViewData["Title"] = "Create Position";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card p-4">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                <h1 class="h4 fw-bold mb-0">Create Job Position</h1>
                <a asp-action="Index" class="btn btn-outline-dark btn-sm">Cancel</a>
            </div>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-semibold"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" autofocus />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status" asp-items="Html.GetEnumSelectList<TalentManagement.Models.Enums.PositionStatus>()" class="form-select"></select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="MaxRecentProjects" class="form-label"></label>
                        <input asp-for="MaxRecentProjects" class="form-control" type="number" min="1" max="20" />
                        <span asp-validation-for="MaxRecentProjects" class="text-danger small"></span>
                        <div class="form-text text-muted">Maximum candidate portfolio projects matching filter tags to display.</div>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="TagsRaw" class="form-label"></label>
                    <input asp-for="TagsRaw" class="form-control" />
                    <span asp-validation-for="TagsRaw" class="text-danger small"></span>
                    <div class="form-text text-muted">Comma-separated tags used to filter and prioritize matching candidate projects.</div>
                </div>

                <div class="mb-4">
                    <h2 class="h5 fw-bold mb-2">Required Skills &amp; Qualifications</h2>
                    <p class="text-muted small">Select which qualifications and skills candidates must answer when applying to this position.</p>

                    @if (Model.AvailableAttributes != null && Model.AvailableAttributes.Any())
                    {
                        <div class="table-responsive border rounded">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th style="width: 50px;">Include</th>
                                        <th>Skill / Qualification</th>
                                        <th>Category</th>
                                        <th style="width: 120px;">Mandatory</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.AvailableAttributes.Count; i++)
                                    {
                                        <tr>
                                            <td class="text-center">
                                                <input type="hidden" asp-for="AvailableAttributes[i].AttributeDefinitionId" />
                                                <input type="hidden" asp-for="AvailableAttributes[i].AttributeName" />
                                                <input type="hidden" asp-for="AvailableAttributes[i].AttributeType" />
                                                <input type="hidden" asp-for="AvailableAttributes[i].CategoryName" />
                                                <input type="hidden" asp-for="AvailableAttributes[i].DisplayOrder" />
                                                <input class="form-check-input" type="checkbox" asp-for="AvailableAttributes[i].IsSelected" />
                                            </td>
                                            <td class="fw-semibold">@Model.AvailableAttributes[i].AttributeName</td>
                                            <td class="small text-muted">@Model.AvailableAttributes[i].CategoryName</td>
                                            <td>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" asp-for="AvailableAttributes[i].IsRequired" />
                                                    <label class="form-check-label small" asp-for="AvailableAttributes[i].IsRequired">Required</label>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-secondary mb-0">
                            No skills or qualifications have been defined yet. <a asp-controller="Attribute" asp-action="Create">Add qualifications first</a>
                        </div>
                    }
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-dark">Create Position</button>
                    <a asp-action="Index" class="btn btn-outline-dark">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
