@using TalentManagement.Data
@model TalentManagement.ViewModels.PositionDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
    var isRecruiter = User.IsInRole(DbInitializer.RecruiterRole);
    var isCandidate = User.IsInRole(DbInitializer.CandidateRole);
}

<div class="card p-4 mb-4">
    <div class="d-flex justify-content-between align-items-start mb-3 pb-3 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <h1 class="h3 fw-bold mb-0">@Model.Title</h1>
                <span class="badge @(Model.Status == TalentManagement.Models.Enums.PositionStatus.Active ? "bg-dark" : "bg-secondary")">
                    @Model.Status
                </span>
            </div>
            <div class="text-muted small">
                Posted by @Model.RecruiterName on @Model.CreatedAt.ToString("yyyy-MM-dd")
                @if (Model.UpdatedAt.HasValue)
                {
                    <span>Updated @Model.UpdatedAt.Value.ToString("yyyy-MM-dd")</span>
                }
            </div>
        </div>
        <div class="d-flex gap-2">
            @if (isRecruiter)
            {
                <a asp-action="Candidates" asp-route-id="@Model.Id" class="btn btn-dark btn-sm">
                    Review CVs (@Model.TotalApplicationsCount)
                </a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-dark btn-sm">
                    Edit
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm">
                    Delete
                </a>
            }
            else if (isCandidate)
            {
                @if (Model.HasCandidateApplied)
                {
                    <a asp-controller="Cv" asp-action="Edit" asp-route-id="@Model.CandidateCvId" class="btn btn-dark btn-sm">
                        Edit My CV
                    </a>
                    <a asp-controller="Cv" asp-action="Details" asp-route-id="@Model.CandidateCvId" class="btn btn-outline-dark btn-sm">
                        View My Submitted CV
                    </a>
                }
                else
                {
                    <a asp-controller="Cv" asp-action="Create" asp-route-positionId="@Model.Id" class="btn btn-dark btn-sm">
                        Create CV &amp; Apply
                    </a>
                }
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn btn-dark btn-sm">
                    Sign in to Apply
                </a>
            }
        </div>
    </div>

    <div class="mb-4">
        <h2 class="h5 fw-bold mb-2">Role Overview</h2>
        <div class="p-3 bg-light rounded text-pre-line">@Model.Description</div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <h2 class="h5 fw-bold mb-2">Project Portfolio Filters</h2>
            <p class="text-muted small mb-2">
                Candidate portfolio projects tagged with these technologies will be prioritized (displaying up to @Model.MaxRecentProjects most recent projects):
            </p>
            @if (Model.TagFilters != null && Model.TagFilters.Any())
            {
                <div class="d-flex flex-wrap gap-1">
                    @foreach (var tag in Model.TagFilters)
                    {
                        <span class="badge bg-secondary fs-6">@tag</span>
                    }
                </div>
            }
            else
            {
                <div class="text-muted small">No specific project tag filters defined.</div>
            }
        </div>

        <div class="col-md-6">
            <h2 class="h5 fw-bold mb-2">Application Statistics</h2>
            <div class="row g-2">
                <div class="col-6">
                    <div class="stat-box text-center p-2">
                        <div class="h3 fw-bold mb-0">@Model.TotalApplicationsCount</div>
                        <div class="stat-label">Total Applications</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="stat-box text-center p-2">
                        <div class="h3 fw-bold mb-0">@Model.PublishedApplicationsCount</div>
                        <div class="stat-label">Published Applications</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-4">
        <h2 class="h5 fw-bold mb-2">Role Requirements &amp; Qualifications</h2>
        <p class="text-muted small mb-2">Candidates applying for this role provide details for the following criteria:</p>

        @if (Model.Attributes != null && Model.Attributes.Any())
        {
            <div class="table-responsive border rounded">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Skill / Qualification</th>
                            <th>Category</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pa in Model.Attributes)
                        {
                            <tr>
                                <td class="fw-semibold">@pa.AttributeDefinition?.Name</td>
                                <td class="small text-muted">@pa.AttributeDefinition?.Category?.Name</td>
                                <td>
                                    @if (pa.IsRequired)
                                    {
                                        <span class="badge bg-dark">MANDATORY</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Optional</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-muted small">No specific qualifications assigned to this position.</div>
        }
    </div>

    <div class="pt-3 border-top">
        <a asp-action="Index" class="btn btn-outline-dark btn-sm">Back to Positions</a>
    </div>
</div>
